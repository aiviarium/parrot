// Claude Code, written against the recordings of 2.1.325 in crates/parrot-tui/fixtures/casts.

// After the trust dialog Claude Code lives on the alternate screen. It never goes quiet while
// waiting (spinner, blinking bullet), so states key on text and structure, not stability.
// Dialogs are drawn with horizontal rules, not boxes. The prompt is a row starting with `❯`
// between two full-width rules, with a mode line below.

profile id="claude-code" name="Claude Code" version-from-screen=#"Claude Code v(\d+\.\d+\.\d+)"# unrecognised-after="10s" {
  match command="claude" version=">=2.1"
}

// ---- nodes ----

// The input between the two rules at the bottom.
node tag="prompt" last=#true {
  where role="input" source="auto:rule-input"
}

// The mode line under the prompt: `⏸ manual mode on · ? for shortcuts`.
node tag="mode-line" first=#true {
  where below="prompt" text-matches=#"(mode on|for shortcuts|to interrupt|shift\+tab|for agents)"# {
    role "hint" "status" "text"
  }
}

// The spinner line above the prompt: `✢ Thinking…`, `* Julienning… (1s · ↓ 20 tokens)`.
node tag="spinner" {
  where role="progress" text-matches="…"
}

// First start in a folder: `Accessing workspace` ... `Yes, I trust this folder`.
node tag="trust-dialog" role="dialog" first=#true {
  where text-matches="(?s)(Accessing workspace|trust this folder)" {
    role "dialog" "pane"
    has role="menu"
  }
}

// Tool permission: Bash, edits, file creation, web fetches. A rule above it, the question,
// numbered options, `Esc to cancel`.
node tag="approval" role="dialog" first=#true {
  where source="auto:rule-section" text-matches="Do you want to (proceed|make this edit|create|allow|delete|overwrite|run)" {
    role "dialog" "pane"
    has role="menu"
  }
}

// The plan approval at the end of plan mode: `Ready to code?` ... `Would you like to proceed?`.
node tag="approval" name="plan-approval" role="dialog" {
  lines from=#"Ready to code\?"# through=#"^\s*(❯\s*)?\d+\.\s"#
}

node tag="plan-approval" {
  where tag="approval" text-matches=#"Ready to code\?"#
}

// AskUserQuestion: a header (`☐ Colour`), the question, numbered options with descriptions,
// `Type something.`, a rule, `Chat about this`, and `Enter to select · ↑/↓ to navigate`.
node tag="question" role="dialog" {
  lines from=#"^\s*[☐☒☑✔]\s"# to="Enter to select"
}

node tag="question" name="question-without-header" role="dialog" first=#true {
  where text-matches="Enter to select · ↑/↓ to navigate" {
    role "dialog" "pane"
    not tag="question"
  }
}

// The /model picker, opened by a row of `▔`.
node tag="model-picker" first=#true {
  where text-matches="Select model" {
    role "dialog" "pane"
  }
}

// The options of whichever dialog is open. In a question the options are split by a rule,
// so they are re-read row by row.
node tag="choices" name="question-choices" role="menu" inside="question" {
  lines from=#"^\s*(❯\s*)?1\.\s"# through=#"^\s*(❯\s*)?\d+\.\s"#
  item line-matches=#"^\s*(❯\s*)?\d+\.\s"# {
    selected-when starts-with="❯"
  }
}

node tag="choices" name="plan-choices" role="menu" inside="plan-approval" {
  lines from=#"^\s*(❯\s*)?1\.\s"# last=#true through=#"^\s*(❯\s*)?\d+\.\s"#
  item line-matches=#"^\s*(❯\s*)?\d+\.\s"# {
    selected-when starts-with="❯"
  }
}

node tag="choices" inside="approval" first=#true {
  where role="menu" {
    not tag="choices"
  }
}

node tag="choices" inside="trust-dialog" first=#true {
  where role="menu"
}

node tag="choices" inside="model-picker" first=#true {
  where role="menu"
}

// The slash-command menu above the prompt while typing `/`.
node tag="slash-menu" {
  where role="menu" above="prompt" text-matches=#"(?m)^\s*(❯\s*)?/[a-z]"#
}

// ---- states, first match wins ----
state name="onboarding" {
  when exists="trust-dialog"
}

state name="awaiting-approval" {
  when exists="approval"
}

state name="awaiting-input" {
  when {
    any exists="question"
    any exists="model-picker"
    any not-exists="prompt" {
      find role="dialog" {
        has role="menu"
      }
    }
  }
}

state name="working" {
  when {
    any exists="spinner"
    any {
      find tag="mode-line" text-contains="esc to interrupt"
    }
  }
}

state name="idle" {
  when exists="prompt"
}

state name="starting" {
  when until-seen="idle"
}

// ---- actions ----
action name="submit" description="Type a prompt and send it." {
  require state="idle" hold="300ms"
  steps type="$text"
  steps timeout="5s" {
    wait text-in="prompt" contains="$text"
  }
  steps key="enter"
  expect within="15s" {
    any {
      state "working" "awaiting-approval" "awaiting-input"
    }
    any empty="prompt"
  }
}

// Several lines go in as a bracketed paste: typing a newline would send the first line alone. A long
// paste shows as `[Pasted text #1 +5 lines]`, so the wait is for anything in the prompt, not the text.
action name="submit-paste" description="Paste a prompt of several lines and send it." {
  require state="idle" hold="300ms"
  steps paste="$text"
  steps timeout="5s" {
    wait {
      not empty="prompt"
    }
  }
  steps key="enter"
  expect within="15s" {
    any {
      state "working" "awaiting-approval" "awaiting-input"
    }
    any empty="prompt"
  }
}

action name="approve" description="Allow the tool call or plan once (the first option)." {
  require state="awaiting-approval" hold="300ms"
  steps {
    select in="choices" index=0
  }
  steps key="enter"
  expect not-exists="approval" within="5s"
}

action name="deny" description="Reject the tool call or plan (Esc)." {
  require state="awaiting-approval" hold="300ms"
  (array)steps key="esc"
  expect not-exists="approval" within="5s"
}

action name="interrupt" {
  require state="working" hold="300ms"
  (array)steps key="esc"
  expect within="5s" {
    (array)not "working"
  }
}

action name="choose" description="Pick an option of the open dialog by its number, shortcut or label." {
  require hold="300ms" {
    state "awaiting-input" "awaiting-approval" "onboarding"
  }
  steps {
    select in="choices" option="$option"
  }
  steps key="enter"
  expect changed="choices" within="5s"
}

action name="trust" description="Accept the folder trust dialog." {
  require state="onboarding" exists="trust-dialog" hold="1s"
  steps {
    select in="choices" label="Yes"
  }
  steps key="enter"
  expect not-exists="trust-dialog" within="10s"
}

action name="open-model-picker" {
  require state="idle" empty="prompt" hold="300ms"
  steps type="/model"
  steps timeout="5s" {
    wait text-in="prompt" contains="/model"
  }
  steps key="enter"
  expect exists="model-picker" within="5s"
}

action name="close-dialog" {
  require hold="300ms" {
    state "awaiting-input" "awaiting-approval"
  }
  (array)steps key="esc"
  expect within="5s" {
    (array)not "awaiting-input"
  }
}

action name="quit" {
  require state="idle" empty="prompt" hold="300ms"
  steps type="/exit"
  steps timeout="5s" {
    wait text-in="prompt" contains="/exit"
  }
  steps key="enter"
  expect not-exists="prompt" within="10s"
}

action name="clear-prompt" description="Delete what is typed in the prompt." {
  require state="idle" hold="300ms"
  (array)steps key="ctrl+u"
  expect empty="prompt" within="3s"
}

// An image or file goes in as its pasted path, which the CLI turns into an attachment.
action name="attach" description="Attach a file by pasting its path." {
  require hold="300ms" {
    state "idle" "working"
  }
  steps paste="$path "
  steps timeout="5s" {
    wait {
      not empty="prompt"
    }
  }
}

// A prompt sent while Claude Code works joins the running turn at its next step.
action name="steer" description="Send a prompt into the running turn." {
  require state="working" hold="300ms"
  steps paste="$text"
  steps key="enter"
}
