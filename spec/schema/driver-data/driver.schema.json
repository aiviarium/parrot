{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DriverFile",
  "description": "The driver data file driver.kdl, read from KDL into this shape.",
  "type": "object",
  "properties": {
    "driver": {
      "description": "How the driver runs.",
      "$ref": "#/$defs/DriverRun"
    },
    "cli": {
      "description": "The harness CLI the driver talks to, and the versions this data covers.",
      "anyOf": [
        {
          "$ref": "#/$defs/CliSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "dataVersion": {
      "description": "The driver data version, reported as `driver.data` on the agent (spec 6).",
      "type": "string"
    },
    "controls": {
      "description": "How the agent can be driven; the first is the default. `native` when left out.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Control"
      },
      "default": [
        "native"
      ]
    },
    "bindings": {
      "description": "How many bindings one driver process serves; any number when left out (spec 30.5).",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "shims": {
      "description": "Version shims: folders whose files replace the egg's own for a range of harness\nversions. The last listed range that holds the detected version wins (spec 31).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ShimSpec"
      }
    },
    "transcript": {
      "description": "Where the TUI core reads the harness's own transcript.",
      "anyOf": [
        {
          "$ref": "#/$defs/TranscriptSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "mcp": {
      "description": "How the TUI core hands the harness the `parrot` MCP server (spec 26).",
      "anyOf": [
        {
          "$ref": "#/$defs/McpStyle"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "driver",
    "dataVersion"
  ],
  "$defs": {
    "DriverRun": {
      "description": "How a driver runs.",
      "oneOf": [
        {
          "description": "A driver compiled into the runtime, served by `parrot driver <name>`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "builtin"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "description": "A program in the egg's `parrot` folder, with a variant per platform when it is a binary.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "command"
            },
            "run": {
              "description": "The program, relative to the egg's `parrot` folder, when no variant matches.",
              "type": [
                "string",
                "null"
              ]
            },
            "args": {
              "description": "Arguments passed to the program.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "variants": {
              "description": "Per-platform programs; the first that matches wins.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/CommandVariant"
              }
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "CommandVariant": {
      "description": "One platform's program.",
      "type": "object",
      "properties": {
        "os": {
          "description": "The OS as Rust names it (`linux`, `macos`, `windows`); any when left out.",
          "type": [
            "string",
            "null"
          ]
        },
        "arch": {
          "description": "The architecture as Rust names it (`x86_64`, `aarch64`); any when left out.",
          "type": [
            "string",
            "null"
          ]
        },
        "run": {
          "description": "The program, relative to the egg's `parrot` folder.",
          "type": "string"
        }
      },
      "required": [
        "run"
      ]
    },
    "CliSpec": {
      "description": "The harness CLI.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The command name, such as `claude`.",
          "type": "string"
        },
        "versions": {
          "description": "A semver range of the CLI versions this data covers, such as `>=2.0`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "Control": {
      "type": "string",
      "enum": [
        "native",
        "tui"
      ]
    },
    "ShimSpec": {
      "description": "One `shim \">=2.2\" dir=\"shims/2.2\"` line.",
      "type": "object",
      "properties": {
        "versions": {
          "description": "A semver range of harness versions.",
          "type": "string"
        },
        "dir": {
          "description": "The folder, relative to the egg's `parrot` folder.",
          "type": "string"
        }
      },
      "required": [
        "versions",
        "dir"
      ]
    },
    "TranscriptSpec": {
      "description": "`transcript \"claude\"`, `transcript \"codex\"` or `transcript \"jsonl\" dir=\"<folder>\"`.",
      "type": "object",
      "properties": {
        "format": {
          "$ref": "#/$defs/TranscriptFormat"
        },
        "dir": {
          "description": "The folder to watch, in place of the format's own. `~` is the home folder.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "format"
      ]
    },
    "TranscriptFormat": {
      "description": "The transcript formats the TUI core reads.",
      "oneOf": [
        {
          "description": "Claude Code's project transcripts, in the folder for the working directory.",
          "type": "string",
          "const": "claude"
        },
        {
          "description": "Codex rollout files under `sessions/`.",
          "type": "string",
          "const": "codex"
        },
        {
          "description": "Plain JSONL messages in `dir`.",
          "type": "string",
          "const": "jsonl"
        }
      ]
    },
    "McpStyle": {
      "description": "How the TUI core passes the `parrot` MCP server to the harness. The token is only ever in\nthe environment.",
      "oneOf": [
        {
          "description": "`--mcp-config <json>`.",
          "type": "string",
          "const": "mcp-config"
        },
        {
          "description": "`-c mcp_servers.parrot.*` config overrides.",
          "type": "string",
          "const": "config-override"
        }
      ]
    }
  }
}
