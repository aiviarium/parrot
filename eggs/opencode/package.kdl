format 1

package {
  group aiviarium
  id opencode
  version "0.1.0"
}

about {
  name "opencode"
  summary "The Parrot driver for opencode, over its HTTP server."
  license MIT
  license Apache-2.0
  repository "https://github.com/aiviarium/parrot"
  keywords parrot driver opencode
}

targets {
  parrot {
    requires {
      parrot "^0.1"
    }
    variants {
      variant os=linux arch=x86_64
      variant os=linux arch=aarch64
      variant os=macos arch=aarch64
      variant os=windows arch=x86_64
    }
  }
}
