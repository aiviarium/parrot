// opencode's event stream is the only source while a binding runs; its stored messages are read
// later from the server, so the native source wins while it is live.
kind "assistant" {
  match "ref"
  prefer "native"
}
kind "reasoning" {
  match "ref"
  prefer "native"
}
kind "tool" {
  match "ref"
  prefer "native"
}
kind "user" {
  match "ref"
  prefer "native"
}
