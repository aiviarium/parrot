format 1

package {
  group aiviarium
  id claude
  version "0.1.0"
}

about {
  name "Claude Code"
  summary "The Parrot driver for Claude Code, native and under TUI control."
  license MIT
  license Apache-2.0
  repository "https://github.com/aiviarium/parrot"
  keywords parrot driver claude
}

targets {
  parrot {
    requires {
      parrot "^0.1"
    }
    variants {
      variant os=linux arch=x86_64
      variant os=linux arch=aarch64
      variant os=macos arch=aarch64
      variant os=windows arch=x86_64
    }
  }
  rookery {
    requires {
      rookery ">=0.6"
    }
  }
}
