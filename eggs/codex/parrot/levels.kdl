// Codex runs commands itself, so the level follows the sandbox and approval policy.
level "read" {
  tool "read"
  tool "search"
  tool "list"
}
level "write" {
  tool "fileChange"
}
level "sandboxed" {
  tool "commandExecution"
}
level "host" {
  tool "mcpToolCall"
  tool "webSearch"
}

map level="read" network=#false {
  when sandbox="read-only" approvalPolicy="untrusted"
  when sandbox="read-only" approvalPolicy="on-request"
  when sandbox="read-only" approvalPolicy="never"
}
map level="write" network=#false { when sandbox="workspace-write" approvalPolicy="untrusted"; }
map level="sandboxed" network=#false {
  when sandbox="workspace-write" approvalPolicy="on-request"
  when sandbox="workspace-write" approvalPolicy="never"
}


// Under a ceiling, the user's config.toml can't loosen what Parrot sets: approvals go to the
// person, the workspace sandbox has no network, and web search (a host tool) is off.
pin {
  arg "-c" "approvals_reviewer=\"user\""
  arg "-c" "sandbox_workspace_write.network_access=false"
  arg "-c" "web_search=\"disabled\""
}
