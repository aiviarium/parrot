format 1

package {
  group aiviarium
  id codex
  version "0.1.0"
}

about {
  name "Codex"
  summary "The Parrot driver for Codex, over its app server."
  license MIT
  license Apache-2.0
  repository "https://github.com/aiviarium/parrot"
  keywords parrot driver codex
}

targets {
  parrot {
    requires {
      parrot "^0.1"
    }
  }
}
