format 1

package {
  group aiviarium
  id t3
  version "0.1.0"
}

about {
  name "T3 Code"
  summary "The Parrot driver for T3 Code, through its MCP tools."
  license MIT
  license Apache-2.0
  repository "https://github.com/aiviarium/parrot"
  keywords parrot driver t3
}

targets {
  parrot {
    requires {
      parrot "^0.1"
    }
    variants {
      variant os=linux arch=x86_64
      variant os=linux arch=aarch64
      variant os=macos arch=aarch64
      variant os=windows arch=x86_64
    }
  }
  rookery {
    requires {
      rookery ">=0.6"
    }
  }
}
