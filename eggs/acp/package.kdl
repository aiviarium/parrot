format 1

package {
  group aiviarium
  id acp
  version "0.1.0"
}

about {
  name "ACP agent"
  summary "The Parrot driver for agents that speak the Agent Client Protocol."
  license MIT
  license Apache-2.0
  repository "https://github.com/aiviarium/parrot"
  keywords parrot driver acp
}

targets {
  parrot {
    requires {
      parrot "^0.1"
    }
  }
}
