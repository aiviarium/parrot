{"fixture": {"scenario": "bash-allowed", "about": "An approval is answered with the choice whose intent is allow, wherever the driver lists it."}}
{"dir": "in", "msg": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocol": [1], "peer": {"kind": "client", "name": "parrot-conform", "version": "0"}, "features": {}}}}
{"dir": "out", "msg": {"jsonrpc": "2.0", "id": 1, "result": {"protocol": 1}}}
{"dir": "in", "msg": {"jsonrpc": "2.0", "id": 2, "method": "session/new", "params": {"agent": "$agent", "workspace": {"kind": "dir", "path": "$dir"}, "cwd": "$dir"}}}
{"dir": "out", "msg": {"jsonrpc": "2.0", "id": 2, "result": {"session": {"id": "$id:session", "cwd": "$dir", "binding": {"agent": "$agent"}}, "subscription": "$id:sub", "head": "$any"}}}
{"check": {"projection": {"state": true, "session": "$id:session"}, "expect": "idle"}}
{"dir": "in", "msg": {"jsonrpc": "2.0", "id": 3, "method": "session/prompt", "params": {"session": "$id:session", "text": "Run ls."}}}
{"dir": "out", "msg": {"jsonrpc": "2.0", "id": 3, "result": {"message": "$id:msg", "disposition": "started"}}}
{"dir": "out", "msg": {"jsonrpc": "2.0", "method": "update", "params": {"session": "$id:session", "update": {"type": "request", "request": {"id": "$id:req", "kind": "approval", "status": "open", "choices": {"$has": {"id": "$id:allow", "intent": "allow", "scope": "once"}}}}}}}
{"dir": "in", "msg": {"jsonrpc": "2.0", "id": 4, "method": "request/answer", "params": {"request": "$id:req", "answer": {"choice": "$id:allow"}}}}
{"dir": "out", "msg": {"jsonrpc": "2.0", "id": 4, "result": {}}}
{"dir": "out", "msg": {"jsonrpc": "2.0", "method": "update", "params": {"session": "$id:session", "update": {"type": "turn", "turn": {"status": "completed"}}}}}
{"check": {"projection": {"items": {"kind": "tool"}, "session": "$id:session"}, "expect": [{"status": "ok"}]}}
