[9.584309, "o", "\u001b[?25l\u001b[H\u001b[38;2;215;119;87m ▝▝   ▝▝ \u001b[12G\u001b[38;2;153;153;153m/…/scratchpad/work-casts/claude2\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWrite a 30 line poem about terminals.\u001b[39m                                         \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTerminals\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BA\u001b[5Gcursor\u001b[12Gblinks\u001b[19Gon\u001b[22Gan\u001b[25Gempty\u001b[31Gblack\u001b[37Gfield,\r\u001b[2C\u001b[1Bthe pr\u001b[10Gmpt waits, p\u001b[23Gti\u001b[26Gnt as a stone.\u001b[K\r\u001b[2C\u001b[1BEach w\u001b[10Grd I type is sent out\u001b[32Gto \u001b[36Ghe shell,\r\u001b[2C\u001b[1Band something answer\u001b[24G, cold and\u001b[35Gknown.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTen\u001b[7Gthousand\u001b[16Glines\u001b[22Gof\u001b[25Gscrollback\u001b[36Gsleep\r\u001b[2C\u001b[1Bin columns gree\u001b[19G on midnight glas\u001b[37G.\u001b[K\r\u001b[2C\u001b[1BI pipe the\u001b[14Goutput, grep the dark,\u001b[K\r\u001b[2C\u001b[1Band watc\u001b[12G the errors bloom and pass.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gold\u001b[11Gteletype\u001b[20Gclattered\u001b[30Gits\u001b[34Gway\r\u001b[2C\u001b[1Bt\u001b[5Grough\u001b[11Gpap\u001b[15Gr, ink, and anc\u001b[31Gent hum.\u001b[24;1H\u001b[22;3H\u001b[?25h"]
[9.686766, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[2B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWrite a 30 line poem about terminals.\u001b[39m                                         \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m●\u001b[3G\u001b[39mTerminals\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1BA\u001b[5Gcursor\u001b[12Gblinks\u001b[19Gon\u001b[22Gan\u001b[25Gempty\u001b[31Gblack\u001b[37Gfield,\r\u001b[2C\u001b[1Bthe pr\u001b[10Gmpt waits, p\u001b[23Gti\u001b[26Gnt as a stone.\u001b[K\r\u001b[2C\u001b[1BEach w\u001b[10Grd I type is sent out\u001b[32Gto \u001b[36Ghe shell,\r\u001b[2C\u001b[1Band something answer\u001b[24G, cold and\u001b[35Gknown.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTen\u001b[7Gthousand\u001b[16Glines\u001b[22Gof\u001b[25Gscrollback\u001b[36Gsleep\r\u001b[2C\u001b[1Bin columns gree\u001b[19G on midnight glas\u001b[37G.\u001b[K\r\u001b[2C\u001b[1BI pipe the\u001b[14Goutput, grep the dark,\u001b[K\r\u001b[2C\u001b[1Band watc\u001b[12G the errors bloom and pass.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gold\u001b[11Gteletype\u001b[20Gclattered\u001b[30Gits\u001b[34Gway\r\u001b[2C\u001b[1Bt\u001b[5Grough\u001b[11Gpap\u001b[15Gr, ink, and anc\u001b[31Gent hum.\r\u001b[2C\u001b[1BIts children learned to\u001b[27Gdraw in\u001b[35Gtext,\u001b[24;1H\u001b[22;3H\u001b[?25h"]
[9.807596, "o", "\u001b[?25l\u001b[H\r\u001b[2B\u001b[38;2;255;255;255m●\u001b[39m Terminals\u001b[K\r\u001b[2B \u001b[3GA cursor blinks\u001b[19Gon\u001b[22Gan\u001b[25Gempty\u001b[31Gblack\u001b[37Gfield,\r\u001b[2C\u001b[1Bthe\u001b[7Gprompt\u001b[14Gwaits,\u001b[21Gpatient\u001b[29Gas\u001b[32Ga\u001b[34Gstone.\r\u001b[2C\u001b[1BEa\u001b[6Gh w\u001b[11Gd I type is sent out to the shell,\r\u001b[2C\u001b[1Band\u001b[7Gsomething answers, cold and known.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BTen\u001b[7Gthousand li\u001b[19Ges of s\u001b[27Grollback sleep\r\u001b[2C\u001b[1Bin\u001b[6Gcolumns\u001b[14Ggreen\u001b[20Gon\u001b[23Gmidnight\u001b[32Gglass.\r\u001b[2C\u001b[1BI pipe the output,\u001b[22Ggrep the d\u001b[33Gr\u001b[35G,\u001b[K\r\u001b[2C\u001b[1Ba\u001b[5Gd watch the \u001b[18Grr\u001b[21Grs bloom and pa\u001b[37Gs.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gold teletype clattered\u001b[30Gits\u001b[34Gw\u001b[36Gy\u001b[K\r\u001b[2C\u001b[1Bthrough\u001b[11Gpaper,\u001b[18Gink,\u001b[23Gand\u001b[27Gancient\u001b[35Ghum.\r\u001b[2C\u001b[1BIts\u001b[7Gchildren learned \u001b[25Go draw in text,\r\u001b[3C\u001b[1Bo make\u001b[11Ga window out of\u001b[28G \u001b[30Grumb.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[24;1H\u001b[22;3H\u001b[?25h"]
