[7.581967, "o", "\u001b[?25l\u001b[H\r\u001b[15B\u001b[38;2;177;185;249m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\u001b[81G\u001b[38;2;153;153;153m◐ medium · /effort\u001b[38;2;177;185;249m ▔\r\u001b[3C\u001b[1B\u001b[1mSelect model\r\u001b[3C\u001b[1B\u001b[22m\u001b[38;2;153;153;153mSwitch between Claude models. Your pick becomes the default for new sessions. For \r\u001b[3C\u001b[1Bother/previous model names, specify with --model.\r\u001b[5C\u001b[2B1.  \u001b[39mDefault\u001b[18G(recommended)\u001b[33G\u001b[38;2;215;119;87mFable 5.2\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153m2.  \u001b[39mOpus 5.5               \u001b[38;2;153;153;153mFor complex work and everyday tasks\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;153;153;153m3.  \u001b[38;2;215;119;87mFable 5.2\u001b[39m              \u001b[38;2;153;153;153mFor your tough\u001b[48Gst challenges\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;153;153;153m4.  \u001b[39mSonnet 5.5             \u001b[38;2;153;153;153mMost \u001b[39Gfficient for simpler tasks\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;177;185;249m❯\u001b[6G\u001b[38;2;153;153;153m5.  \u001b[38;2;78;186;101mHaiku 5.5\u001b[20G✔\u001b[33G\u001b[38;2;153;153;153mFastest for quick answers\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;153;153;153m▸   \u001b[39mMore models            \u001b[38;2;153;153;153m \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B   \u001b[38;2;215;119;87m◐\u001b[38;2;153;153;153m Medium effort (default) ←/→ to adjust\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B \u001b[38;2;153;153;153mEnter to set\u001b[17Gas default · s to use this session only · Esc to cancel\u001b[39m\u001b[30;1H\u001b[25;4H"]
