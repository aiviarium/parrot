// A Task call runs a subagent, which the host stops through its task.
{"expect": {"type": "user"}}
{"emit": {"type": "system", "subtype": "init", "session_id": "sess-fake-stop", "model": "default", "permissionMode": "default"}}
{"emit": {"type": "assistant", "message": {"id": "msg_st_01", "role": "assistant", "content": [{"type": "tool_use", "id": "toolu_task_02", "name": "Task", "input": {"description": "Walk the tree", "prompt": "Walk the tree slowly", "subagent_type": "general-purpose"}}]}, "parent_tool_use_id": null, "session_id": "sess-fake-stop", "uuid": "a-st-01"}}
{"emit": {"type": "system", "subtype": "task_started", "task_id": "task-fake-02", "tool_use_id": "toolu_task_02", "description": "Walk the tree", "subagent_type": "general-purpose", "session_id": "sess-fake-stop"}}
{"emit": {"type": "assistant", "message": {"id": "msg_st_02", "role": "assistant", "content": [{"type": "text", "text": "Walking."}]}, "parent_tool_use_id": "toolu_task_02", "session_id": "sess-fake-stop"}}
{"expect": {"type": "control_request", "request": {"subtype": "stop_task", "task_id": "task-fake-02"}}}
{"emit": {"type": "control_response", "response": {"subtype": "success", "request_id": "{{request_id}}", "response": {}}}}
{"emit": {"type": "system", "subtype": "task_notification", "task_id": "task-fake-02", "tool_use_id": "toolu_task_02", "status": "stopped", "output_file": "", "summary": "Stopped", "session_id": "sess-fake-stop"}}
{"emit": {"type": "user", "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "toolu_task_02", "content": "Stopped", "is_error": true}]}, "parent_tool_use_id": null, "session_id": "sess-fake-stop", "uuid": "u-st-01"}}
{"emit": {"type": "result", "subtype": "success", "is_error": false, "result": "Stopped.", "session_id": "sess-fake-stop", "usage": {"input_tokens": 3, "output_tokens": 5}}}
